#!/usr/bin/env bash
#
# ccr — Claude Code Resume
# Browse all Claude Code sessions across every project, pick one in an fzf
# menu (with preview), then auto-cd into its working directory and resume.
# Optionally enable mobile Remote Control on resume.
#
# Requirements: bash, fzf, python3, and the `claude` CLI.
# Language: auto-detected from $LANG; override with --lang zh|en or $CCR_LANG.
#
# Usage:
#   ccr                      List sessions from every project (sorted by time)
#   ccr .                    Only sessions whose cwd is under the current dir
#   ccr <path>               Only sessions whose cwd is under <path>
#   ccr --last               Resume the most recent session (no menu)
#   ccr -n|--nth <N>         Resume the Nth most recent session (no menu)
#   ccr -f|--fork            Resume into a new session id (--fork-session)
#   ccr -x|--expired         Also list sessions Claude has already cleaned up
#   ccr -s|--sort <key>      Sort by: time (default) | title | dir
#   ccr -l|--lang <zh|en>    UI language (default: auto-detect)
#   ccr -h|--help            Show help
#   ccr -V|--version         Show the version
#
# In-menu keys:
#   Enter   resume
#   Ctrl-R  resume + mobile Remote Control (--remote-control)
#   Ctrl-F  fork: resume into a new session id (--fork-session)
#   Ctrl-Y  print the command only (don't run)
#   Ctrl-X  show/hide cleaned-up (expired) sessions
#   Ctrl-T  sort by time     Ctrl-O sort by title     Ctrl-G sort by dir
#   Esc     quit
#
# MIT License — see the LICENSE file. https://github.com/kylinfish/claude-code-resume
#
set -euo pipefail

VERSION="0.3.0"

CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
PROJECTS_DIR="${CCR_PROJECTS_DIR:-$CONFIG_DIR/projects}"
HISTORY_FILE="${CCR_HISTORY_FILE:-$CONFIG_DIR/history.jsonl}"
DESKTOP_DIR="${CCR_DESKTOP_DIR:-$HOME/Library/Application Support/Claude/local-agent-mode-sessions}"
CODEX_DIR="${CODEX_HOME:-$HOME/.codex}"
TAB=$'\t'

# Invoked as `ccc` (or with CCR_CODEX=1): also list OpenAI Codex sessions.
PROG="$(basename "$0")"
case "$PROG" in
  ccc*) CODEX_MODE=1 ;;
  *)    CODEX_MODE="${CCR_CODEX:-0}" ;;
esac

# ---------------------------------------------------------------------------
# i18n
# ---------------------------------------------------------------------------
# Resolve language: explicit arg > $CCR_LANG > $LANG/$LC_ALL autodetect.
resolve_lang() {
  local v="${1:-${CCR_LANG:-}}"
  if [ -z "$v" ]; then
    case "${LC_ALL:-}${LANG:-}" in
      zh*|*_zh*|*zh_*) v=zh ;;
      *)               v=en ;;
    esac
  fi
  case "$v" in
    zh*|cn|tw|CN|TW|ZH*) printf 'zh' ;;
    *)                   printf 'en' ;;
  esac
}
LANG_MODE="$(resolve_lang)"

# t <key> [printf-args...] -> localized string (no trailing newline).
t() {
  local k="$1"; shift
  local fmt=''
  case "$LANG_MODE:$k" in
    zh:need_fzf)     fmt='ccr：需要 fzf，請先安裝（brew install fzf）' ;;
    en:need_fzf)     fmt='ccr: fzf is required (install: brew install fzf)' ;;
    zh:need_python)  fmt='ccr：需要 python3' ;;
    en:need_python)  fmt='ccr: python3 is required' ;;
    zh:no_projects)  fmt='ccr：找不到 %s' ;;
    en:no_projects)  fmt='ccr: %s not found' ;;
    zh:unknown_opt)  fmt='ccr：未知選項 %s' ;;
    en:unknown_opt)  fmt='ccr: unknown option %s' ;;
    zh:sort_invalid) fmt='ccr：--sort 只接受 time|title|dir（預設 time）' ;;
    en:sort_invalid) fmt='ccr: --sort accepts time|title|dir (default: time)' ;;
    zh:lang_invalid) fmt='ccr：--lang 只接受 zh|en' ;;
    en:lang_invalid) fmt='ccr: --lang accepts zh|en' ;;
    zh:no_session)   fmt='ccr：%s 底下沒有找到 session' ;;
    en:no_session)   fmt='ccr: no sessions found under %s' ;;
    zh:no_session_all) fmt='ccr：沒有找到任何 session' ;;
    en:no_session_all) fmt='ccr: no sessions found' ;;
    zh:cancelled)    fmt='已取消' ;;
    en:cancelled)    fmt='Cancelled' ;;
    zh:parse_sid)    fmt='ccr：無法解析 session id' ;;
    en:parse_sid)    fmt='ccr: failed to parse session id' ;;
    zh:dir_missing)  fmt='ccr：目錄不存在：%s' ;;
    en:dir_missing)  fmt='ccr: directory does not exist: %s' ;;
    zh:nth_invalid)  fmt='ccr：-n/--nth 需要正整數' ;;
    en:nth_invalid)  fmt='ccr: -n/--nth requires a positive integer' ;;
    zh:nth_oob)      fmt='ccr：沒有第 %s 個 session' ;;
    en:nth_oob)      fmt='ccr: no session at position %s' ;;
    zh:pv_missing)   fmt='⚠ 目錄已不存在' ;;
    en:pv_missing)   fmt='⚠ directory no longer exists' ;;
    zh:pv_last)      fmt='💬 最後的 prompt' ;;
    en:pv_last)      fmt='💬 last prompt' ;;
    zh:header)       fmt=$'Enter 開啟  ^R +手機遠端  ^F 分支  ^Y 只印指令  │  排序 ^T 時間 ^O 標題 ^G 目錄  │  Esc 取消' ;;
    en:header)       fmt=$'Enter resume  ^R +remote  ^F fork  ^Y print cmd  │  sort ^T time ^O title ^G dir  │  Esc quit' ;;
    zh:header2)      fmt=$'^X 顯示／隱藏已清理的 session  │  Desktop 對話以 fork 在 CLI 開啟' ;;
    en:header2)      fmt=$'^X show/hide expired sessions  │  Desktop sessions open as a fork' ;;
    zh:retention)    fmt='⚠ Claude 會自動刪除 %s 天沒有活動的對話；在 %s 加上 "cleanupPeriodDays": 365 可保留更久' ;;
    en:retention)    fmt='⚠ Claude deletes sessions idle for %s days; add "cleanupPeriodDays": 365 to %s to keep them longer' ;;
    zh:expired_cant) fmt='ccr：這個 session 的對話紀錄已被 Claude 清理，無法 resume' ;;
    en:expired_cant) fmt='ccr: this session'"'"'s transcript was cleaned up by Claude; it cannot be resumed' ;;
    zh:expired_first) fmt='第一句 prompt：%s' ;;
    en:expired_first) fmt='first prompt: %s' ;;
    zh:pv_expired)   fmt='✗ 對話紀錄已被清理（只剩 prompt 歷史），無法 resume' ;;
    en:pv_expired)   fmt='✗ transcript was cleaned up (only prompt history is left); cannot resume' ;;
    zh:pv_desktop)   fmt='🖥 Claude Desktop（Cowork）對話：會以 fork 在 CLI 開啟，Desktop 裡的原對話不會變動' ;;
    en:pv_desktop)   fmt='🖥 Claude Desktop (Cowork) session: opens in the CLI as a fork; the original stays untouched in Desktop' ;;
    zh:pv_folders)   fmt='📂 授權資料夾' ;;
    en:pv_folders)   fmt='📂 granted folders' ;;
    zh:pv_first)     fmt='💬 第一句 prompt' ;;
    en:pv_first)     fmt='💬 first prompt' ;;
    zh:pane_title)   fmt='⚙ 背後正在跑的 process（所有 session 專案，依 CPU 排序）' ;;
    en:pane_title)   fmt='⚙ processes running under your session projects (by CPU)' ;;
    zh:pane_none)    fmt='  （沒有偵測到正在跑的 port 或 watcher）' ;;
    en:pane_none)    fmt='  (no listening ports or watchers detected)' ;;
    zh:pane_more)    fmt='  …還有 %s 個' ;;
    en:pane_more)    fmt='  … %s more' ;;
    zh:resume_procs) fmt='⚙ 這個專案背後仍在執行、可能佔用資源的 process：' ;;
    en:resume_procs) fmt='⚙ still running under this project (may be using resources):' ;;
    zh:header3)      fmt=$'^A 來源切換：全部 → Claude → Codex  │  或輸入 ^claude／^codex 篩選' ;;
    en:header3)      fmt=$'^A cycle source: all → Claude → Codex  │  or type ^claude / ^codex' ;;
    zh:need_codex)   fmt='ccr：找不到 codex CLI，無法 resume Codex session' ;;
    en:need_codex)   fmt='ccr: the codex CLI is not on PATH; cannot resume a Codex session' ;;
    zh:codex_no_rc)  fmt='ccr：Codex 沒有 Remote Control；請改用 Enter（resume）或 ^F（fork）' ;;
    en:codex_no_rc)  fmt='ccr: Codex has no Remote Control; use Enter (resume) or ^F (fork) instead' ;;
    zh:pv_codex)     fmt='🤖 Codex session · Enter = codex resume · ^F = codex fork' ;;
    en:pv_codex)     fmt='🤖 Codex session · Enter = codex resume · ^F = codex fork' ;;
    *)               fmt="$k" ;;
  esac
  # messages say whichever name we were run as (ccr / ccc)
  fmt="${fmt//ccr：/${PROG}：}"
  fmt="${fmt//ccr: /${PROG}: }"
  # shellcheck disable=SC2059
  printf "$fmt" "$@"
}

print_help() {
  if [ "$CODEX_MODE" = 1 ]; then
    print_help_body | sed '1s/.*/ccc — Claude Code + Codex Resume/; s/^  ccr/  ccc/'
    if [ "$LANG_MODE" = zh ]; then
      cat <<'EOF'

Codex（ccc 專屬）：
  也會列出 OpenAI Codex 的 session（讀 ~/.codex/state_*.sqlite，失敗時改讀 rollout 檔）。
  Enter → codex resume <id>，Ctrl-F → codex fork <id>；Codex 沒有 Remote Control。
  Ctrl-A  來源切換：全部 → Claude → Codex
  列表最前面一欄是 claude／codex；輸入 ^claude 或 ^codex 可直接篩選
  （Desktop 與已清理的 session 算 claude）
  CODEX_HOME=<dir>        覆寫 Codex 目錄（預設 ~/.codex）
EOF
    else
      cat <<'EOF'

Codex (ccc only):
  OpenAI Codex sessions are listed too (from ~/.codex/state_*.sqlite, falling
  back to the rollout files). Enter → codex resume <id>, Ctrl-F → codex fork
  <id>; Codex has no Remote Control.
  Ctrl-A  cycle source: all → Claude → Codex
  The first column is claude / codex; type ^claude or ^codex to filter by it
  (Desktop and expired sessions count as claude).
  CODEX_HOME=<dir>        override the Codex dir (default: ~/.codex)
EOF
    fi
  else
    print_help_body
  fi
}

print_help_body() {
  if [ "$LANG_MODE" = zh ]; then
    cat <<'EOF'
ccr — Claude Code Resume

掃描所有 Claude Code 歷史 session，用 fzf 選單 + preview 呈現，
選定後自動 cd 到該專案目錄並 resume（可選擇開啟手機遠端控制）。

用法：
  ccr                      列出所有專案的 session（預設依時間排序）
  ccr .                    只列出當前目錄(含子目錄)的 session
  ccr <path>               只列出指定目錄(含子目錄)的 session
  ccr --last               不開選單，直接續最近一個 session
  ccr -n|--nth <N>         不開選單，直接續第 N 新的 session
  ccr -f|--fork            以新的 session id 分支續接（--fork-session）
  ccr -x|--expired         一併列出已被 Claude 清理的 session
  ccr -s|--sort <key>      排序：time(預設) | title | dir
  ccr -l|--lang <zh|en>    介面語言（預設：自動偵測 $LANG）
  ccr -h|--help            顯示說明
  ccr -V|--version         顯示版本

選單內快捷鍵：
  Enter   開啟（resume）
  Ctrl-R  resume + 手機遠端控制 (--remote-control)
  Ctrl-F  分支：以新的 session id 續接 (--fork-session)
  Ctrl-Y  只印出指令，不執行
  Ctrl-X  顯示／隱藏已清理的 session
  Ctrl-T  依時間排序   Ctrl-O 依標題   Ctrl-G 依目錄
  Esc     取消

環境變數：
  CCR_LANG=zh|en          覆寫語言
  CCR_PROJECTS_DIR=<dir>  覆寫掃描路徑（預設 ~/.claude/projects）
  CCR_DESKTOP_DIR=<dir>   覆寫 Claude Desktop Cowork 對話的路徑
  CCR_HISTORY_FILE=<file> 覆寫 prompt 歷史檔（預設 ~/.claude/history.jsonl）

Claude Desktop（Cowork）的對話也會列出，並一律以 fork 在 CLI 開啟，
Desktop 裡的原對話不會變動。
選單上方的 process 區會列出所有 session 目錄底下仍在跑的 port／watcher，
有 process 的 session 標 ⚙，resume 前也會印出（需要 lsof）。
EOF
  else
    cat <<'EOF'
ccr — Claude Code Resume

Browse all Claude Code sessions across every project in an fzf menu
(with preview), then auto-cd into the session's working directory and
resume it. Optionally enable mobile Remote Control on resume.

Usage:
  ccr                      List sessions from every project (sorted by time)
  ccr .                    Only sessions whose cwd is under the current dir
  ccr <path>               Only sessions whose cwd is under <path>
  ccr --last               Resume the most recent session (no menu)
  ccr -n|--nth <N>         Resume the Nth most recent session (no menu)
  ccr -f|--fork            Resume into a new session id (--fork-session)
  ccr -x|--expired         Also list sessions Claude has already cleaned up
  ccr -s|--sort <key>      Sort by: time (default) | title | dir
  ccr -l|--lang <zh|en>    UI language (default: auto-detect from $LANG)
  ccr -h|--help            Show this help
  ccr -V|--version         Show the version

In-menu keys:
  Enter   resume
  Ctrl-R  resume + mobile Remote Control (--remote-control)
  Ctrl-F  fork: resume into a new session id (--fork-session)
  Ctrl-Y  print the command only (don't run)
  Ctrl-X  show/hide cleaned-up (expired) sessions
  Ctrl-T  sort by time   Ctrl-O sort by title   Ctrl-G sort by dir
  Esc     quit

Environment:
  CCR_LANG=zh|en          override language
  CCR_PROJECTS_DIR=<dir>  override scan path (default: ~/.claude/projects)
  CCR_DESKTOP_DIR=<dir>   override the Claude Desktop Cowork sessions dir
  CCR_HISTORY_FILE=<file> override the prompt history file (default: ~/.claude/history.jsonl)

Claude Desktop (Cowork) sessions are listed too; they always open in the CLI
as a fork, so the original stays untouched in Desktop.
A process pane above the list shows ports/watchers still running under any
session's directory; sessions with one get a ⚙ mark, and resuming prints them
(needs lsof).
EOF
  fi
}

# resume_session <sid|transcript> <cwd> [remote:0|1] [fork:0|1] — cd into the project and resume.
resume_session() {
  local sid="$1" cwd="$2" remote="${3:-0}" fork="${4:-0}"
  [ -n "$sid" ] || { echo "$(t parse_sid)" >&2; exit 1; }
  if [ -n "$cwd" ] && [ ! -d "$cwd" ]; then
    echo "$(t dir_missing "$cwd")" >&2; exit 1
  fi
  local cmd=(claude --resume "$sid")
  [ "$remote" = 1 ] && cmd+=(--remote-control)
  [ "$fork" = 1 ] && cmd+=(--fork-session)
  local procs
  procs="$(runtime_lines "$cwd")"
  if [ -n "$procs" ]; then printf '%s\n%s\n' "$(t resume_procs)" "$procs"; fi
  echo "→ cd $cwd"
  echo "→ ${cmd[*]}"
  [ -n "${CCR_STATE:-}" ] && rm -f "$CCR_STATE"
  cd "$cwd"
  exec "${cmd[@]}"
}

# resume_codex <id> <cwd> [fork:0|1] — cd into the project and resume in Codex.
resume_codex() {
  local sid="$1" cwd="$2" fork="${3:-0}"
  [ -n "$sid" ] || { echo "$(t parse_sid)" >&2; exit 1; }
  command -v codex >/dev/null 2>&1 || { echo "$(t need_codex)" >&2; exit 1; }
  if [ -n "$cwd" ] && [ ! -d "$cwd" ]; then
    echo "$(t dir_missing "$cwd")" >&2; exit 1
  fi
  local cmd=(codex resume "$sid")
  [ "$fork" = 1 ] && cmd=(codex fork "$sid")
  local procs
  procs="$(runtime_lines "$cwd")"
  if [ -n "$procs" ]; then printf '%s\n%s\n' "$(t resume_procs)" "$procs"; fi
  echo "→ cd $cwd"
  echo "→ ${cmd[*]}"
  [ -n "${CCR_STATE:-}" ] && rm -f "$CCR_STATE"
  cd "$cwd"
  exec "${cmd[@]}"
}

# ---------------------------------------------------------------------------
# preview subcommand: invoked by fzf with the highlighted row's fields
#   $1 title  $2 when(human)  $3 rel  $4 cwd  $5 last_prompt  $6 sessionId
#   $7 kind  $8 target  $9 extra   (see scan for the meaning of the last three)
# ---------------------------------------------------------------------------
do_preview() {
  local title="${1:-}" when="${2:-}" rel="${3:-}" cwd="${4:-}" last="${5:-}" sid="${6:-}"
  local kind="${7:-cli}" target="${8:-}" extra="${9:-}"
  local C_RESET=$'\033[0m' C_TITLE=$'\033[1;36m' C_DIM=$'\033[2m' C_WARN=$'\033[1;31m' C_KEY=$'\033[33m'
  local C_DESK=$'\033[35m'
  printf '%s📌 %s%s\n\n' "$C_TITLE" "$title" "$C_RESET"
  printf '%s🕒%s %s  %s(%s)%s\n' "$C_KEY" "$C_RESET" "$when" "$C_DIM" "$rel" "$C_RESET"
  if [ "$kind" = expired ]; then
    printf '%s%s%s\n' "$C_WARN" "$(t pv_expired)" "$C_RESET"
    printf '%s📁%s %s\n%s🔑%s %s\n' "$C_KEY" "$C_RESET" "$cwd" "$C_KEY" "$C_RESET" "$sid"
    [ -n "$extra" ] && printf '\n%s%s%s\n%s\n' "$C_KEY" "$(t pv_first)" "$C_RESET" "$extra"
    return 0
  fi
  if [ "$kind" = codex ]; then
    printf '%s%s%s\n' $'\033[36m' "$(t pv_codex)" "$C_RESET"
    [ -n "$extra" ] && printf '%s🌿%s %s\n' "$C_KEY" "$C_RESET" "$extra"
  fi
  if [ "$kind" = desktop ]; then
    printf '%s%s%s\n' "$C_DESK" "$(t pv_desktop)" "$C_RESET"
    [ -n "$extra" ] && printf '%s%s%s %s\n' "$C_KEY" "$(t pv_folders)" "$C_RESET" "$extra"
  fi
  if [ -n "$cwd" ] && [ ! -d "$cwd" ]; then
    printf '%s📁 %s  %s%s\n' "$C_WARN" "$cwd" "$(t pv_missing)" "$C_RESET"
  else
    printf '%s📁%s %s\n' "$C_KEY" "$C_RESET" "$cwd"
  fi
  printf '%s🔑%s %s\n' "$C_KEY" "$C_RESET" "$sid"
  if [ -n "$last" ]; then
    printf '\n%s%s%s\n%s\n' "$C_KEY" "$(t pv_last)" "$C_RESET" "$last"
  fi
}

# ---------------------------------------------------------------------------
# scan: parse every jsonl, emit one TSV row per session, sorted.
#   args: <filter_dir> <sort_key> <show_expired:0|1> ; language from $LANG_MODE
#   columns: DISPLAY \t sessionId \t cwd \t when \t rel \t title \t last_prompt
#            \t kind \t target \t extra
#   kind:   cli     — a CLI session in $PROJECTS_DIR (target/extra empty)
#           desktop — a Claude Desktop Cowork session; target = transcript
#                     path, extra = folders the user granted it
#           expired — only left in history.jsonl (transcript was cleaned up);
#                     extra = the session's first prompt
# ---------------------------------------------------------------------------
scan() {
  python3 - "$PROJECTS_DIR" "${1:-}" "${2:-time}" "$LANG_MODE" "${3:-0}" \
    "$HISTORY_FILE" "$DESKTOP_DIR" "$CODEX_MODE" "$CODEX_DIR" "${4:-all}" <<'PY'
import sys, os, re, json, glob, time, unicodedata, hashlib

projects_dir = sys.argv[1]
filter_dir   = sys.argv[2]
sort_key     = sys.argv[3]
lang         = sys.argv[4]
show_expired = sys.argv[5] == "1"
history_file = sys.argv[6]
desktop_dir  = sys.argv[7]
with_codex   = sys.argv[8] == "1"
codex_dir    = sys.argv[9]
source       = sys.argv[10]  # all | claude | codex
now = time.time()

# --- index cache: avoid re-parsing jsonl files whose mtime is unchanged ---
cache_home = os.environ.get("CCR_CACHE") or os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "ccr")
cache_file = os.path.join(
    cache_home, "index-v2-" + hashlib.md5(projects_dir.encode("utf-8")).hexdigest()[:8] + ".json")
try:
    with open(cache_file, encoding="utf-8") as _cf:
        _cache = json.load(_cf)
    if not isinstance(_cache, dict):
        _cache = {}
except Exception:
    _cache = {}
new_cache = {}
cache_dirty = False

# --- ANSI palette (256-color) ---
ESC = "\x1b"
R   = ESC + "[0m"
def col(n): return ESC + "[38;5;" + str(n) + "m"
SEP        = col(240) + "│" + R    # dim grey separator
C_RECENT   = col(78)               # green   (< 1 day)
C_MID      = col(180)              # warm    (< 7 days)
C_OLD      = col(244)              # dim     (older)
C_TITLE    = col(253)             # near-white
C_TITLE_LO = col(244)             # dim (untitled / system)
C_PATH     = col(110)             # soft blue
C_DESKTOP  = col(176)             # soft magenta (Claude Desktop rows)
C_EXPIRED  = col(240)             # dark grey (expired rows)
C_CODEX    = col(80)              # teal (Codex rows)
C_CLAUDE   = col(173)             # orange (Claude tag in the ccc tool column)

def dwidth(s):
    return sum(2 if unicodedata.east_asian_width(c) in ("W", "F") else 1 for c in s)

def fit(s, width, align="left"):
    total = dwidth(s)
    if total <= width:
        pad = " " * (width - total)
        return pad + s if align == "right" else s + pad
    out, w = "", 0
    for c in s:
        cw = 2 if unicodedata.east_asian_width(c) in ("W", "F") else 1
        if w + cw > width - 1:
            break
        out += c
        w += cw
    out += "…"
    w += 1
    return out + " " * (width - w)

def rel_time(epoch):
    d = now - epoch
    if lang == "zh":
        if d < 60:        return "剛剛"
        if d < 3600:      return f"{int(d//60)} 分鐘前"
        if d < 86400:     return f"{int(d//3600)} 小時前"
        if d < 86400*30:  return f"{int(d//86400)} 天前"
        if d < 86400*365: return f"{int(d//(86400*30))} 個月前"
        return f"{int(d//(86400*365))} 年前"
    else:
        if d < 60:        return "just now"
        if d < 3600:      return f"{int(d//60)}m ago"
        if d < 86400:     return f"{int(d//3600)}h ago"
        if d < 86400*30:  return f"{int(d//86400)}d ago"
        if d < 86400*365: return f"{int(d//(86400*30))}mo ago"
        return f"{int(d//(86400*365))}y ago"

def clean(s):
    if not s: return ""
    return " ".join(str(s).split())

def shorten_path(p):
    home = os.path.expanduser("~")
    if p and p.startswith(home):
        return "~" + p[len(home):]
    return p

def first_text(content):
    if isinstance(content, str): return content
    if isinstance(content, list):
        for part in content:
            if isinstance(part, dict) and part.get("type") == "text":
                return part.get("text", "")
    return ""

def in_filter(cwd):
    if not filter_dir:
        return True
    return cwd == filter_dir or cwd.startswith(filter_dir.rstrip("/") + "/")

def parse_transcript(path, mtime):
    """-> (cwd, title, last), from the cache when the file is unchanged."""
    global cache_dirty
    ent = _cache.get(path)
    if ent and ent.get("mtime") == mtime:
        # unchanged file -> reuse cached extraction (already cleaned)
        new_cache[path] = ent
        return ent.get("cwd", ""), ent.get("title", ""), ent.get("last", "")
    cache_dirty = True
    cwd = ""
    custom_title = agent_name = ai_title = summary = None
    first_user = last_prompt = last_user = None
    with open(path, "r", encoding="utf-8", errors="replace") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                d = json.loads(line)
            except Exception:
                continue
            ty = d.get("type")
            if not cwd and d.get("cwd"):
                cwd = d["cwd"]
            if ty == "custom-title" and d.get("customTitle"):
                custom_title = d["customTitle"]
            elif ty == "agent-name" and d.get("agentName"):
                agent_name = d["agentName"]
            elif ty == "ai-title" and d.get("aiTitle"):
                ai_title = d["aiTitle"]
            elif ty == "summary" and d.get("summary"):
                summary = d["summary"]
            elif ty == "last-prompt" and d.get("lastPrompt"):
                last_prompt = d["lastPrompt"]
            elif ty == "user":
                txt = first_text(d.get("message", {}).get("content"))
                if txt:
                    if first_user is None:
                        first_user = txt
                    last_user = txt
    title = custom_title or agent_name or ai_title or summary or (first_user[:60] if first_user else "") or "(untitled)"
    last  = last_prompt or last_user or ""
    if not cwd:
        cwd = os.path.dirname(path)
    title = clean(title)
    last  = clean(last)
    new_cache[path] = {"mtime": mtime, "cwd": cwd, "title": title, "last": last}
    return cwd, title, last

def recency_color(epoch):
    d = now - epoch
    return C_RECENT if d < 86400 else (C_MID if d < 7*86400 else C_OLD)

# session dirs with processes still running under them (from the process pane)
busy = set(filter(None, os.environ.get("CCR_BUSY", "").split("\n")))

# rows: (epoch, title, sort_dir, is_expired, tsv)
rows = []
live_sids = set()

def add_row(epoch, sid, cwd, title, last, kind, target, extra, path_label, pathc):
    when = time.strftime("%Y-%m-%d %H:%M", time.localtime(epoch))
    rel  = rel_time(epoch)
    if kind == "expired":
        relc = titlec = pathc = C_EXPIRED
    else:
        relc = recency_color(epoch)
        titlec = C_TITLE_LO if (title == "(untitled)" or title.startswith("<")) else C_TITLE
    mark = "⚙ " if kind != "expired" and cwd.rstrip("/") in busy else "  "
    # ccc: a leading tool column, so typing ^claude / ^codex filters by tool
    tool = ""
    if with_codex:
        tname, tc = ("codex", C_CODEX) if kind == "codex" else ("claude", C_CLAUDE)
        if kind == "expired":
            tc = C_EXPIRED
        tool = f"{tc}{fit(tname, 6)}{R} {SEP} "
    display = (f"{tool}{relc}{fit(rel, 9, 'right')}{R} {SEP} "
               f"{C_MID}{mark}{R}{titlec}{fit(title, 42)}{R} {SEP} {pathc}{path_label}{R}")
    rows.append((epoch, title, path_label, kind == "expired",
                 "\t".join([display, sid, cwd, when, rel, title, last, kind, target, extra])))

# --- 1. CLI sessions: <projects>/<slug>/<sessionId>.jsonl ---
for path in glob.glob(os.path.join(projects_dir, "*", "*.jsonl")):
    try:
        mtime = os.path.getmtime(path)
        cwd, title, last = parse_transcript(path, mtime)
    except OSError:
        continue
    sid = os.path.splitext(os.path.basename(path))[0]
    live_sids.add(sid)
    if in_filter(cwd):
        add_row(mtime, sid, cwd, title, last, "cli", "", "", shorten_path(cwd), C_PATH)

# --- 2. Claude Desktop (Cowork) sessions ---
# <desktop>/<account>/<org>/local_<id>.json holds the metadata; the transcript
# is <that path without .json>/.claude/projects/<slug>/<cliSessionId>.jsonl
for meta_path in glob.glob(os.path.join(desktop_dir, "*", "*", "local_*.json")):
    try:
        with open(meta_path, encoding="utf-8") as fh:
            meta = json.load(fh)
    except Exception:
        continue
    if not isinstance(meta, dict) or meta.get("isArchived"):
        continue
    sid = meta.get("cliSessionId") or ""
    sandbox = meta_path[:-len(".json")]
    found = glob.glob(os.path.join(sandbox, ".claude", "projects", "*", sid + ".jsonl")) if sid else []
    if not found:
        continue
    transcript = found[0]
    folders = [f for f in (meta.get("userSelectedFolders") or []) if isinstance(f, str)]
    if filter_dir and not any(in_filter(f) for f in folders):
        continue
    try:
        mtime = os.path.getmtime(transcript)
        tcwd, ttitle, last = parse_transcript(transcript, mtime)
    except OSError:
        continue
    act = meta.get("lastActivityAt")
    epoch = act / 1000.0 if isinstance(act, (int, float)) and act > 0 else mtime
    title = clean(meta.get("title")) or ttitle
    run_dir = os.path.join(sandbox, "outputs")
    if not os.path.isdir(run_dir):
        run_dir = tcwd if os.path.isdir(tcwd) else sandbox
    label = "Desktop · " + (shorten_path(folders[0]) if folders else "Cowork")
    add_row(epoch, sid, run_dir, title, last, "desktop", transcript,
            ", ".join(shorten_path(f) for f in folders), label, C_DESKTOP)

# --- 2b. OpenAI Codex sessions (ccc only) ---
# Codex keeps a thread index in <codex>/state_<N>.sqlite. It is internal and
# versioned, so read it read-only, look columns up by name, and fall back to
# the rollout files' session_meta lines when it can't be used.
def codex_rows():
    import sqlite3
    out = []
    dbs = sorted(glob.glob(os.path.join(codex_dir, "state_*.sqlite")),
                 key=lambda p: int(re.sub(r"\D", "", os.path.basename(p)) or 0))
    if dbs:
        try:
            con = sqlite3.connect("file:" + dbs[-1] + "?mode=ro", uri=True, timeout=1)
            con.row_factory = sqlite3.Row
            cols = {r[1] for r in con.execute("pragma table_info(threads)")}
            pick = lambda *names: next((n for n in names if n in cols), None)
            sel = {k: pick(*v) for k, v in {
                "id": ("id",), "cwd": ("cwd",), "updated": ("updated_at", "recency_at"),
                "name": ("name",), "title": ("title",), "preview": ("preview", "first_user_message"),
                "branch": ("git_branch",), "model": ("model",), "tokens": ("tokens_used",),
                "archived": ("archived",), "source": ("source",)}.items()}
            if not (sel["id"] and sel["cwd"] and sel["updated"]):
                raise ValueError("unexpected threads schema")
            q = "select " + ", ".join(f"{v} as {k}" for k, v in sel.items() if v) + " from threads"
            for r in con.execute(q):
                r = dict(r)
                if r.get("archived"):
                    continue
                if str(r.get("source") or "cli") not in ("cli", "vscode"):
                    continue  # subagents, reviews, mcp/exec threads
                out.append(r)
            con.close()
            return out
        except Exception:
            out = []
    names = {}
    try:
        with open(os.path.join(codex_dir, "session_index.jsonl"), encoding="utf-8") as fh:
            for line in fh:
                try:
                    d = json.loads(line)
                    names[d["id"]] = d.get("thread_name") or ""
                except Exception:
                    pass
    except OSError:
        pass
    for path in glob.glob(os.path.join(codex_dir, "sessions", "*", "*", "*", "rollout-*.jsonl")):
        try:
            with open(path, encoding="utf-8", errors="replace") as fh:
                meta = json.loads(fh.readline()).get("payload") or {}
                if str(meta.get("source") or "cli") not in ("cli", "vscode"):
                    continue
                preview = ""
                for i, line in enumerate(fh):
                    if i > 200:
                        break
                    try:
                        d = json.loads(line)
                    except Exception:
                        continue
                    pl = d.get("payload") or {}
                    if d.get("type") == "event_msg" and pl.get("type") == "user_message":
                        preview = pl.get("message") or ""
                        break
            out.append({"id": meta.get("id"), "cwd": meta.get("cwd") or "",
                        "updated": os.path.getmtime(path), "name": names.get(meta.get("id"), ""),
                        "preview": preview, "branch": (meta.get("git") or {}).get("branch") or ""})
        except Exception:
            continue
    return out

if with_codex:
    for r in codex_rows():
        sid, cwd = r.get("id") or "", r.get("cwd") or ""
        if not sid or not in_filter(cwd):
            continue
        upd = r.get("updated") or 0
        epoch = upd / 1000.0 if upd > 1e12 else float(upd)
        title = clean(r.get("name")) or clean(r.get("preview"))[:60] or clean(r.get("title"))[:60] or "(untitled)"
        bits = [b for b in (r.get("branch"), r.get("model")) if b]
        if r.get("tokens"):
            bits.append(f"{int(r['tokens']):,} tokens")
        add_row(epoch, sid, cwd, title, clean(r.get("preview") or r.get("title")),
                "codex", "", " · ".join(bits), shorten_path(cwd), C_CODEX)

# --- 3. expired sessions: still in history.jsonl, transcript cleaned up ---
if show_expired and os.path.isfile(history_file):
    hist = {}
    try:
        with open(history_file, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                try:
                    d = json.loads(line)
                except Exception:
                    continue
                sid = d.get("sessionId")
                if not sid or sid in live_sids:
                    continue
                ts = d.get("timestamp")
                ts = ts / 1000.0 if isinstance(ts, (int, float)) else 0
                disp = clean(d.get("display"))
                e = hist.get(sid)
                if e is None:
                    e = hist[sid] = {"last": ts, "project": d.get("project") or "", "first": ""}
                e["last"] = max(e["last"], ts)
                # first real prompt, skipping slash commands like /clear
                if not e["first"] and disp and not disp.startswith("/"):
                    e["first"] = disp
    except OSError:
        hist = {}
    for sid, e in hist.items():
        if not in_filter(e["project"]):
            continue
        title = e["first"] or "(untitled)"
        add_row(e["last"], sid, e["project"], title[:60], "", "expired", "", title,
                shorten_path(e["project"]) + " ✗", C_EXPIRED)

if sort_key == "title":
    rows.sort(key=lambda r: r[1].casefold())
elif sort_key in ("dir", "workdir"):
    rows.sort(key=lambda r: (r[2].casefold(), -r[0]))
else:
    rows.sort(key=lambda r: r[0], reverse=True)
# expired rows can't be resumed: keep them below everything else
rows.sort(key=lambda r: r[3])
if source != "all":
    want = {"codex"} if source == "codex" else {"cli", "desktop", "expired"}
    rows = [r for r in rows if r[-1].split("\t")[7] in want]

for r in rows:
    print(r[-1])

# Persist the cache if anything was parsed or files disappeared.
if cache_dirty or set(new_cache) != set(_cache):
    try:
        os.makedirs(cache_home, exist_ok=True)
        tmp = cache_file + ".tmp"
        with open(tmp, "w", encoding="utf-8") as _cf:
            json.dump(new_cache, _cf)
        os.replace(tmp, cache_file)
    except Exception:
        pass
PY
}

# retention_days -> prints "<days> <set:0|1>" for Claude's transcript cleanup
retention_days() {
  python3 - "$CONFIG_DIR/settings.json" <<'PY'
import sys, json
try:
    with open(sys.argv[1], encoding="utf-8") as fh:
        v = json.load(fh).get("cleanupPeriodDays")
except Exception:
    v = None
print(f"{v} 1" if isinstance(v, int) and not isinstance(v, bool) else "30 0")
PY
}

# --- per-menu state shared with fzf-spawned subcommands (sort, expired) ---
state_get() {  # state_get <key> <default>
  local v=''
  [ -n "${CCR_STATE:-}" ] && [ -f "$CCR_STATE" ] && v="$(sed -n "s/^$1=//p" "$CCR_STATE")"
  printf '%s' "${v:-$2}"
}
state_set() {  # state_set <key> <value>
  [ -n "${CCR_STATE:-}" ] || return 0
  { grep -v "^$1=" "$CCR_STATE" 2>/dev/null || true; printf '%s=%s\n' "$1" "$2"; } > "$CCR_STATE.tmp"
  mv "$CCR_STATE.tmp" "$CCR_STATE"
}

# ---------------------------------------------------------------------------
# runtime: processes still running under a session's directory — listening
# ports (dev servers an agent left running) and known dev commands/watchers.
#   runtime_procs <dir>... -> TSV rows:
#     ports|- \t pid \t cpu% \t rss_kb \t command \t dir
#   dir is the deepest of the given dirs the process runs under. $HOME and /
#   are ignored as targets — everything would match them.
#   (never an empty field: bash `read` would collapse the tabs and shift columns)
# Rows come from `ps` + `lsof`, cached for a few seconds so moving through the
# menu doesn't re-run them for every highlighted row.
# ---------------------------------------------------------------------------
runtime_procs() {
  python3 - "$(id -u)" "$@" <<'PY'
import sys, os, re, json, time, subprocess

uid  = sys.argv[1]
home = os.path.expanduser("~")
targets = sorted({t.rstrip("/") for t in sys.argv[2:]
                  if t and t.rstrip("/") not in ("", home)}, key=len, reverse=True)
if not targets:
    sys.exit(0)
TTL = 5

cache_home = os.environ.get("CCR_CACHE") or os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "ccr")
cache_file = os.path.join(cache_home, "runtime.json")

# Commands worth reporting even without a listening port.
DEV_CMD = re.compile(
    r"(^|[/\s])(vite|next|nuxt|webpack|rollup|esbuild|parcel|tsc|nodemon|"
    r"jest|vitest|playwright|storybook|astro|remix|gatsby|turbo|nx|npm|pnpm|"
    r"yarn|bun|deno|node|python[0-9.]*|uvicorn|gunicorn|flask|rails|puma|"
    r"php|air|cargo|docker|serverless|sls|sam|http-server|live-server|"
    r"browser-sync|watchman|entr|watchexec)(\s|$)")
# Never report these: shells, editors, claude itself, and this tool.
SKIP_CMD = re.compile(r"(^|/)(-?zsh|-?bash|-?sh|fish|claude|codex|fzf|ccr|ccc|vim|nvim|tmux|login)(\s|$)")
AGENTS = ("claude", "codex")
def is_agent(c):
    # claude, codex, or a node/bun shim running one (`node …/bin/codex resume`)
    w = c.split()
    names = [os.path.basename(x) for x in w[:2]]
    return bool(names) and (names[0] in AGENTS or
                            (names[0] in ("node", "bun") and len(names) > 1 and names[1] in AGENTS))

def run(args):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=3).stdout
    except Exception:
        return ""

def collect():
    procs = {}  # pid -> dict
    for line in run(["ps", "-axo", "pid=,ppid=,pcpu=,rss=,uid=,command="]).splitlines():
        parts = line.split(None, 5)
        if len(parts) < 6 or parts[4] != uid:
            continue
        pid, ppid, cpu, rss, _, cmd = parts
        procs[pid] = {"ppid": ppid, "cpu": cpu, "rss": rss, "cmd": cmd, "ports": []}
    # listening TCP ports of this user's processes
    pid = None
    for line in run(["lsof", "-nP", "-a", "-u", uid, "-iTCP", "-sTCP:LISTEN", "-Fpn"]).splitlines():
        if line.startswith("p"):
            pid = line[1:]
        elif line.startswith("n") and pid in procs:
            port = line.rsplit(":", 1)[-1]
            if port.isdigit() and port not in procs[pid]["ports"]:
                procs[pid]["ports"].append(port)
    def cmd_name(c):
        return os.path.basename(c.split()[0]) if c.split() else ""
    cand = []
    for p, e in procs.items():
        if SKIP_CMD.search(cmd_name(e["cmd"])) or is_agent(e["cmd"]):
            continue
        # MCP servers etc. started directly by a claude/codex process are not demos
        parent = procs.get(e["ppid"])
        if parent and is_agent(parent["cmd"]) and not e["ports"]:
            continue
        if e["ports"] or DEV_CMD.search(e["cmd"]):
            cand.append(p)
    if cand:
        pid = None
        for line in run(["lsof", "-a", "-d", "cwd", "-p", ",".join(cand), "-Fpn"]).splitlines():
            if line.startswith("p"):
                pid = line[1:]
            elif line.startswith("n") and pid in procs:
                procs[pid]["cwd"] = line[1:]
    return {"at": time.time(), "procs": procs, "cand": cand}

data = None
try:
    with open(cache_file, encoding="utf-8") as fh:
        data = json.load(fh)
    if time.time() - data.get("at", 0) > TTL:
        data = None
except Exception:
    data = None
if data is None:
    data = collect()
    try:
        os.makedirs(cache_home, exist_ok=True)
        tmp = cache_file + ".tmp." + str(os.getpid())
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(data, fh)
        os.replace(tmp, cache_file)
    except Exception:
        pass

procs = data["procs"]
def owner(p):
    c = procs[p].get("cwd", "")
    for t in targets:  # deepest first
        if c == t or c.startswith(t + "/"):
            return t
    return None
hits = [p for p in data["cand"] if p in procs and owner(p)]

def ancestors(p):
    seen = set()
    while p in procs and p not in seen:
        seen.add(p)
        p = procs[p]["ppid"]
        yield p

# One row per process tree: keep port holders first, then any other process
# that is neither an ancestor nor a descendant of one already kept.
kept = [p for p in hits if procs[p]["ports"]]
for p in sorted((p for p in hits if not procs[p]["ports"]), key=int):
    if any(a in kept for a in ancestors(p)):
        continue
    if any(p in set(ancestors(k)) for k in kept):
        continue
    kept.append(p)

def short_cmd(c, t):
    # program name only (not /opt/homebrew/Cellar/…/python3.13), args with
    # the project dir shown as ./ and $HOME as ~/
    words = c.split()
    if not words:
        return c
    rest = " ".join(words[1:]).replace(t + "/", "./").replace(home + "/", "~/")
    return (os.path.basename(words[0]) + " " + rest).strip()

# busiest first, so the pane shows what is eating resources at the top
kept.sort(key=lambda p: (-float(procs[p]["cpu"] or 0), -int(procs[p]["rss"] or 0)))
for p in kept:
    e, t = procs[p], owner(p)
    print("\t".join([",".join(e["ports"]) or "-", p, e["cpu"], e["rss"], short_cmd(e["cmd"], t), t]))
PY
}

# runtime_lines [--pane] <dir>... — human-readable list. --pane is the menu's
# process pane: each line also names its project, highlighted in color.
runtime_lines() {
  local pane=0 port pid cpu rss cmd dir mb portf
  local c0='' cP='' cN='' cC='' cD='' cU='' cHot=''
  if [ "${1:-}" = --pane ]; then
    pane=1; shift
    c0=$'\033[0m' cP=$'\033[1;93m' cN=$'\033[97m' cC=$'\033[1;97m'
    cD=$'\033[96m' cU=$'\033[4;92m' cHot=$'\033[1;91m'
  fi
  runtime_procs "$@" | while IFS="$TAB" read -r port pid cpu rss cmd dir; do
    mb=$(( (${rss:-0} + 512) / 1024 ))
    if [ "$pane" = 1 ]; then
      cmd="$cC$(printf '%-34s' "${cmd:0:34}")$c0 $cD${dir/#$HOME/~}$c0"
    elif [ ${#cmd} -gt 60 ]; then
      cmd="${cmd:0:59}…"
    fi
    local cpuc="$cN"
    [ "$pane" = 1 ] && [ "${cpu%%.*}" -ge 50 ] 2>/dev/null && cpuc="$cHot"
    if [ "$port" != - ]; then portf=":${port%%,*}"; else portf="-"; fi
    printf '  %s%-7s%s %sPID %-6s%s %s%5s%% CPU%s %s%5s MB%s  %s' \
      "$cP" "$portf" "$c0" "$cN" "$pid" "$c0" "$cpuc" "$cpu" "$c0" "$cN" "$mb" "$c0" "$cmd"
    if [ "$port" != - ]; then printf '  %s→ http://localhost:%s%s' "$cU" "${port%%,*}" "$c0"; fi
    printf '\n'
  done
}

# ---------------------------------------------------------------------------
# dispatch (internal subcommands invoked by fzf run in fresh processes;
# they read language/filter from the exported env)
# ---------------------------------------------------------------------------
case "${1:-}" in
  __preview) shift; do_preview "$@"; exit 0 ;;
  __list)    # __list [sort] — remembers the sort so ^X can reload without it
    shift
    if [ -n "${1:-}" ]; then state_set sort "$1"; fi
    scan "${CCR_FILTER:-}" "$(state_get sort "${1:-time}")" "$(state_get expired 0)" "$(state_get source all)"
    exit 0 ;;
  __cycle_source)  # all -> claude -> codex -> all
    case "$(state_get source all)" in
      all)    state_set source claude ;;
      claude) state_set source codex ;;
      *)      state_set source all ;;
    esac
    exit 0 ;;
  __toggle_expired)
    if [ "$(state_get expired 0)" = 1 ]; then state_set expired 0; else state_set expired 1; fi
    exit 0 ;;
  -h|--help) print_help; exit 0 ;;
  -V|--version) printf '%s %s\n' "$(basename "$0")" "$VERSION"; exit 0 ;;
esac

command -v fzf     >/dev/null 2>&1 || { echo "$(t need_fzf)"    >&2; exit 1; }
command -v python3 >/dev/null 2>&1 || { echo "$(t need_python)" >&2; exit 1; }
[ -d "$PROJECTS_DIR" ] || { echo "$(t no_projects "$PROJECTS_DIR")" >&2; exit 1; }

# --- argument parsing ---
SORT="time"
FILTER=""
LANG_OVERRIDE=""
FORK=0     # 1 => resume with --fork-session
EXPIRED=0  # 1 => start the menu with expired sessions shown
NTH=""     # set => resume directly without the menu (Nth in sorted order)
while [ $# -gt 0 ]; do
  case "$1" in
    -s|--sort) SORT="${2:-time}"; shift 2 ;;
    --sort=*)  SORT="${1#*=}"; shift ;;
    -l|--lang) LANG_OVERRIDE="${2:-}"; shift 2 ;;
    --lang=*)  LANG_OVERRIDE="${1#*=}"; shift ;;
    -n|--nth)  NTH="${2:-}"; shift 2 ;;
    --nth=*)   NTH="${1#*=}"; shift ;;
    --last)    NTH=1; shift ;;
    -f|--fork) FORK=1; shift ;;
    -x|--expired) EXPIRED=1; shift ;;
    -h|--help) print_help; exit 0 ;;
    -V|--version) printf '%s %s\n' "$(basename "$0")" "$VERSION"; exit 0 ;;
    .)         FILTER="$PWD"; shift ;;
    -*)        echo "$(t unknown_opt "$1")" >&2; exit 1 ;;
    *)         FILTER="$(cd "$1" 2>/dev/null && pwd || printf '%s' "$1")"; shift ;;
  esac
done

if [ -n "$NTH" ]; then
  case "$NTH" in
    ''|*[!0-9]*) echo "$(t nth_invalid)" >&2; exit 1 ;;
  esac
  [ "$NTH" -ge 1 ] || { echo "$(t nth_invalid)" >&2; exit 1; }
fi

if [ -n "$LANG_OVERRIDE" ]; then
  case "$LANG_OVERRIDE" in
    zh*|en*|cn|tw|CN|TW|ZH*|EN*) LANG_MODE="$(resolve_lang "$LANG_OVERRIDE")" ;;
    *) echo "$(t lang_invalid)" >&2; exit 1 ;;
  esac
fi
case "$SORT" in
  time|title|dir|workdir) ;;
  *) echo "$(t sort_invalid)" >&2; exit 1 ;;
esac

# Export so fzf-spawned subcommands (__preview/__list) inherit them
export CCR_LANG="$LANG_MODE"
export CCR_FILTER="$FILTER"
export CCR_SELF="$0"
export CCR_CODEX="$CODEX_MODE"

# Quick resume: skip the menu and resume the Nth CLI session in sorted order.
if [ -n "$NTH" ]; then
  LINE="$(scan "$FILTER" "$SORT" 0 | awk -F"$TAB" '$8 == "cli" || $8 == "codex"' | sed -n "${NTH}p")"
  [ -n "$LINE" ] || { echo "$(t nth_oob "$NTH")" >&2; exit 1; }
  SID="$(printf '%s' "$LINE" | cut -d"$TAB" -f2)"
  CWD="$(printf '%s' "$LINE" | cut -d"$TAB" -f3)"
  if [ "$(printf '%s' "$LINE" | cut -d"$TAB" -f8)" = codex ]; then resume_codex "$SID" "$CWD" "$FORK"; fi
  resume_session "$SID" "$CWD" 0 "$FORK"
fi

CCR_STATE="$(mktemp "${TMPDIR:-/tmp}/ccr-state.XXXXXX")"
export CCR_STATE
trap 'rm -f "$CCR_STATE" "$CCR_STATE.tmp"' EXIT
state_set sort "$SORT"
state_set expired "$EXPIRED"

DATA="$(scan "$FILTER" "$SORT" "$EXPIRED")"
if [ -z "$DATA" ]; then
  if [ -n "$FILTER" ]; then echo "$(t no_session "$FILTER")" >&2
  else echo "$(t no_session_all)" >&2; fi
  exit 0
fi

# Process pane: what is still running under any listed session's directory.
DIRS=()
while IFS= read -r d; do DIRS+=("$d"); done <<EOF
$(printf '%s\n' "$DATA" | awk -F"$TAB" '$8 != "expired" && $3 != "" {print $3}' | sort -u)
EOF
PANE_MAX=8
PANE=$'\033[1;97m'"$(t pane_title)"$'\033[0m'
if [ ${#DIRS[@]} -gt 0 ]; then PROCS="$(runtime_lines --pane "${DIRS[@]}")"; else PROCS=""; fi
if [ -n "$PROCS" ]; then
  PANE="$PANE"$'\n'"$(printf '%s\n' "$PROCS" | sed -n "1,${PANE_MAX}p")"
  N="$(printf '%s\n' "$PROCS" | wc -l | tr -d ' ')"
  [ "$N" -gt "$PANE_MAX" ] && PANE="$PANE"$'\n'"$(t pane_more "$((N - PANE_MAX))")"
  # mark sessions that have something running, then rebuild the rows
  CCR_BUSY="$(runtime_procs "${DIRS[@]}" | cut -d"$TAB" -f6 | sort -u)"
  export CCR_BUSY
  DATA="$(scan "$FILTER" "$SORT" "$EXPIRED")"
else
  PANE="$PANE"$'\n'"$(t pane_none)"
fi
PANE="$PANE"$'\n\033[38;5;240m'"$(printf '─%.0s' $(seq 1 72))"$'\033[0m'

HEADER="$PANE"$'\n'"$(t header)"$'\n'"$(t header2)"
[ "$CODEX_MODE" = 1 ] && HEADER="$HEADER"$'\n'"$(t header3)"
SOURCE_BIND=()
[ "$CODEX_MODE" = 1 ] && SOURCE_BIND=(--bind 'ctrl-a:execute-silent("$CCR_SELF" __cycle_source)+reload("$CCR_SELF" __list)')
read -r KEEP_DAYS KEEP_SET <<EOF
$(retention_days)
EOF
if [ "$KEEP_SET" = 0 ] || [ "$KEEP_DAYS" -lt 90 ]; then
  HEADER="$HEADER"$'\n\033[33m'"$(t retention "$KEEP_DAYS" "$CONFIG_DIR/settings.json")"$'\033[0m'
fi

# Show only column 1 (DISPLAY); preview/sort use the hidden columns.
RESULT="$(
  printf '%s\n' "$DATA" | fzf \
    --ansi \
    --delimiter="$TAB" \
    --with-nth=1 \
    --no-hscroll \
    --reverse \
    --border \
    --prompt="[$SORT] ❯ " \
    --header="$HEADER" \
    --header-first \
    --expect=ctrl-r,ctrl-f,ctrl-y \
    --bind 'ctrl-t:reload("$CCR_SELF" __list time)+change-prompt([time] ❯ )' \
    --bind 'ctrl-o:reload("$CCR_SELF" __list title)+change-prompt([title] ❯ )' \
    --bind 'ctrl-g:reload("$CCR_SELF" __list dir)+change-prompt([dir] ❯ )' \
    --bind 'ctrl-x:execute-silent("$CCR_SELF" __toggle_expired)+reload("$CCR_SELF" __list)' \
    ${SOURCE_BIND[@]+"${SOURCE_BIND[@]}"} \
    --preview="\"\$CCR_SELF\" __preview {6} {4} {5} {3} {7} {2} {8} {9} {10}" \
    --preview-window='down,45%,wrap,border-top'
)" || { echo "$(t cancelled)"; exit 0; }

# --expect output: line 1 = key (empty for Enter), line 2 = selected row
KEY="$(printf '%s\n' "$RESULT" | sed -n '1p')"
LINE="$(printf '%s\n' "$RESULT" | sed -n '2p')"
[ -n "$LINE" ] || { echo "$(t cancelled)"; exit 0; }

SID="$(printf '%s' "$LINE" | cut -d"$TAB" -f2)"
CWD="$(printf '%s' "$LINE" | cut -d"$TAB" -f3)"
KIND="$(printf '%s' "$LINE" | cut -d"$TAB" -f8)"
TARGET="$(printf '%s' "$LINE" | cut -d"$TAB" -f9)"
EXTRA="$(printf '%s' "$LINE" | cut -d"$TAB" -f10)"

case "$KIND" in
  expired)  # transcript is gone: say so and show what the session was about
    echo "$(t expired_cant)" >&2
    echo "  📁 $CWD" >&2
    [ -n "$EXTRA" ] && echo "  $(t expired_first "$EXTRA")" >&2
    exit 1 ;;
  desktop)  # resume the Cowork transcript by path, always as a fork
    FORK=1; SID="$TARGET" ;;
  codex)
    case "$KEY" in
      ctrl-y)
        if [ "$FORK" = 1 ]; then printf 'cd %q && codex fork %q\n' "$CWD" "$SID"
        else printf 'cd %q && codex resume %q\n' "$CWD" "$SID"; fi
        exit 0 ;;
      ctrl-r) echo "$(t codex_no_rc)" >&2; exit 1 ;;
      ctrl-f) resume_codex "$SID" "$CWD" 1 ;;
      *)      resume_codex "$SID" "$CWD" "$FORK" ;;
    esac ;;
esac

case "$KEY" in
  ctrl-y)  # print the command only, don't run
    printf 'cd %q && claude --resume %q%s\n' "$CWD" "$SID" "$([ "$FORK" = 1 ] && printf ' --fork-session')"
    exit 0 ;;
  ctrl-r)  resume_session "$SID" "$CWD" 1 "$FORK" ;;
  ctrl-f)  resume_session "$SID" "$CWD" 0 1 ;;
  *)       resume_session "$SID" "$CWD" 0 "$FORK" ;;
esac
